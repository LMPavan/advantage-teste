# Conexão com o PostgreSQL
DATABASE_URL=postgres://app:app@localhost:5432/precodepraca
PORT=3000
# Mínimo de postos distintos para publicar uma estatística
K_MINIMO=5
# Dias após o domingo para enviar NF da semana (2 = até terça 23h59)
PRAZO_DIAS=2
# Pasta com os certificados da ICP-Brasil (.cer/.crt/.pem) para validar a cadeia da assinatura da NF-e
ICP_BRASIL_CA_DIR=
# 1 libera a NF-e de exemplo e o login de demonstração. Nunca use em produção.
DEMO=0
# Código que o cliente digita no cadastro. Vazio = cadastro aberto.
CODIGO_CONVITE=
# Administrador criado na primeira subida (senha com 10+ caracteres)
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=
# Carga inicial do piloto: até esta data (AAAA-MM-DD) aceita notas das últimas CARGA_INICIAL_SEMANAS semanas
# e não publica nada; no dia seguinte publica todas as semanas de uma vez.
CARGA_INICIAL_ATE=
CARGA_INICIAL_SEMANAS=8
# E-mail (lembretes e recuperação de senha). Sem SMTP_URL, as mensagens só aparecem no log.
SMTP_URL=
EMAIL_REMETENTE=
# Endereço público do app, usado nos links dos e-mails (no Render é preenchido sozinho)
APP_URL=
# Dados do operador exibidos nos termos de uso e na política de privacidade
OPERADOR_NOME=
OPERADOR_CNPJ=
OPERADOR_EMAIL=
OPERADOR_FORO=
# Mudar a versão pede novo aceite de todos os usuários
TERMOS_VERSAO=2026-10-piloto-v1
